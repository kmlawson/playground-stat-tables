  "title": "[Dietary at Present]",
  "en": null,
  "chapter": "Watch — Police Force",
  "caption_extra": "[Context, added by the transcriber: the dietary described in the prose 'Causes of the prevalence of Tuberculosis', in use at the time of the 1922 report.] The dietary which at present is as follows:— (no column headings printed; 'Item' and 'Quantity' supplied by the transcriber)",
  "parts": [
   {
    "label": null,
    "columns": [
     "Item",
     "Quantity"
    ],
    "row_labels": [
     "Rice",
     "Wheat",
     "Red bean",
     "Green bean",
     "Onions",
     "Cabbage",
     "Oil"
    ],
    "rows": 7
   }
  ],
  "footnotes": [
   "To this is added on succeeding days in rotation Beef 1½ ozs. Pork 1½ ozs. Fish 1½ ozs. Red beans 1½ ozs."
  ]
 },
 {
