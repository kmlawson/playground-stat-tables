              "Abolition of inland transit dues :",
              "",
              ""
            ],
            [
              "",
              "(A) Period of investigation ...",
              "Dec. 1st, 1925.",
              "Six months (May 31st, 1926)"
            ],
            [
              "",
              "(B) Period of discussion and decision ...",
              "June 1st, 1926.",
              "Six months (Nov. 30th, 1926)"
            ],
            [
              "",
              "(C) Period of actual abolition :",
              "",
              ""
            ],
            [
              "",
              "(I) Dues on freight carried by railways ...",
              "Jan. 1st. 1927.",
              "Two months (Feb. 28th, 1927)"
            ],
            [
              "",
              "(II) Duties levied by Native Custom Houses (Outside of 50 li from treaty ports and in the interior) ...",
