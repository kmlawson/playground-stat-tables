            "Short haul (U. S. currency)"
          ],
          "rows": [
            [
              "Canal boats",
              "$0.0073",
              "$0.0293"
            ],
            [
              "Carry coolies",
              ".44",
              "1.21"
            ],
            [
              "Wheelbarrows",
              ".1687",
              ".1687"
            ],
            [
              "Hand carts",
              ".0773",
              ".0773"
            ],
            [
              "Trucks alone",
              "...",
