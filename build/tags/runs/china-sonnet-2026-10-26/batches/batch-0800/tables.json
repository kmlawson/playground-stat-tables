      "chapter": "Government Structure",
      "table_no": null,
      "title": "[Categories of persons who cannot qualify as hsien citizens]",
      "caption_extra": "persons within any one of the following categories cannot qualify as citizens:",
      "continued": false,
      "parts": [
        {
          "label": null,
          "columns": [
            "No.",
            "Item"
          ],
          "rows": [
            [
              "(a)",
              "Those who have been deprived of their civic rights."
            ],
            [
              "(b)",
              "Those who have defaulted with public funds."
            ],
            [
              "(c)",
              "Those who have been punished for bribery or embezzlement."
            ],
            [
              "(d)",
              "Those who have been prohibited from owning property."
            ],
            [
              "(e)",
              "Those who consume opium and its substitutes (Article 6)."
            ]
          ]
        }
      ],
      "footnotes": [],
