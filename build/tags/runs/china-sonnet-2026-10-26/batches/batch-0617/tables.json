      "chapter": "Finance",
      "table_no": null,
      "title": "[Purposes of the remitted Italian share of the Indemnity]",
      "caption_extra": "Indemnity Remissions. Italy. The outstanding portion of the Italian indemnity is to be administered by a Sino-Italian Commission and used equally for :",
      "continued": false,
      "parts": [
        {
          "label": null,
          "columns": [
            "No.",
            "Item"
          ],
          "rows": [
            [
              "(a)",
              "Sino-Italian educational and philanthropic undertakings;"
            ],
            [
              "(b)",
              "Public works the materials for which are to be purchased in Italy. The latter include :"
            ],
            [
              "(i)",
              "A steel bridge on the Shanghai-Hangchow-Ningpo Railway and other bridges on Government railways;"
            ],
            [
              "(ii)",
              "Hwai River Conservancy;"
            ],
            [
              "(iii)",
              "The Construction of a port at Haichow;"
            ],
            [
              "(iv)",
              "Peking City improvements."
            ]
          ]
        }
      ],
      "footnotes": [
        "Italian and Chinese Engineers are to be employed in equal proportions."
      ],
      "transcriber_notes": [
        "Lettered/numbered list printed in the text; (i)-(iv) are sub-items of (b)."
      ],
      "id": "p1038_1",
      "scans": [
        {
          "label": "scan leaf 1038",
          "url": "https://archive.org/details/china-year-book-1929-30/page/n1038/mode/1up"
        }
      ]
    }
