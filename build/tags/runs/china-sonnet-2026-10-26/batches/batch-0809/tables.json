      "table_no": null,
      "title": "[Scale of pensions for judges]",
      "caption_extra": "Pension for Judges. According to regulations promulgated on November 18, 1940 (the date of enforcement has not yet been announced) Chinese judges above 60 years of age who retire either of their own accord or are asked to retire because of health reasons, are entitled to pension, the scale of which is as follows:",
      "continued": false,
      "parts": [
        {
          "label": null,
          "columns": [
            "Length of Service",
            "Amount of Pension"
          ],
          "rows": [
            [
              "Above 6 years but below 9 years",
              "Aggregate of four months' salary"
            ],
            [
              "Above 9 years but below 12 years",
              "Aggregate of eight months' salary"
            ],
            [
              "Above 12 years but below 15 years",
              "One year's salary"
            ],
            [
              "Above 15 years",
              "Either a life pension paid in annual instalments each amounting to one-third of a year's salary, or a lump sum amounting to 18 months' salary."
            ]
          ]
        }
      ],
