      "table_no": null,
      "title": "Amendment to Customs Import Tariff",
      "caption_extra": "Under Customs Notification No. 1155 dated June 15, 1929, the public is notified that instructions have been received from the Inspector-General of Customs to the effect that the classification of motor vehicles under Tariff No. 714 has been amended as follows and that duty is to be collected accordingly from June 7, 1929.",
      "continued": false,
      "parts": [
        {
          "label": null,
          "columns": [
            "No.",
            "Name of Article",
            "Unit",
            "Duty"
          ],
          "rows": [
            [
              "714",
              "Vehicles, Motor :",
              "",
              ""
            ],
            [
              "",
              "(a) Complete Motor Passenger Vehicles (i.e., Motor Chars-a-bancs, etc.)—with seats for not less than 12 passengers, or Motor Trucks or Motor Lorries (including Truck Chassis) over 1 ton carrying capacity",
              "Value",
              "12½%"
            ],
            [
              "",
              "(b) Others (assembled or in parts) (including Motor-cycles, Motor-cars, Motor Passenger Vehicle Chassis, and all other Motor Vehicles not otherwise enumerated, and all Parts, Tyres, and other Accessories for any kind of Motor Vehicle)",
              "\"",
              "22½%"
            ]
          ]
        }
      ],
      "footnotes": [],
      "transcriber_notes": [
        "Unit for (b) printed as ditto marks (,,), recorded as '\"'.",
        "Duty fractions printed as ½ and read as 12½% and 22½%."
      ],
