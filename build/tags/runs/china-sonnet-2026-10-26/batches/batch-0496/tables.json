            [
              "Mid-Tertiary",
              "Vertical movements resulted in warping or block faulting. Folding insignificant.",
              "Extrusion of extensive Miocene basalt and possibly also most of the porphyries.",
              "\"Horst\" or \"Graben\" are formed in some regions as a result of the vertical displacement. Such movement may still going on to-day as evidenced by the distribution of the seismic centres."
            ],
            [
              "Upper Jurassic",
              "Intense horizontal movement producing folding, thrusting or shearing.",
              "Intrusion of granite and diabasic sheet, extrusion of lava flow.",
              "The Tsingling range was formed at this period."
            ],
            [
              "Pre-Carboniferous",
              "Epirogenic movement i.e. the strata are not folded—discon-formity.",
              "Igneous activity not marked.",
              ""
            ],
            [
              "End of Wutai",
              "Orogenic movement all over the country—marked unconformity between the Wutai and the younger formations.",
              "Intrusion of granites, diorites, gabbros, etc. Intense metamorphism.",
              "In the Wutai system itself, three epochs of tectonic movements may be distinguished."
            ],
            [
              "End of Archaean",
              "Great orogenic movements—marked unconformity between Wutai & Archaean.",
              "Intense metamorphism and igneous intrusions.",
              ""
            ]
          ]
        }
