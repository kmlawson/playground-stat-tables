              "Total exports to foreign countries and to other Chinese ports",
              "$2,132,508",
              "$18,976,745",
              "$34,761,431"
            ],
            [
              "Imports from foreign countries",
              "3,285,907",
              "11,468,621",
              "34,552,117"
            ],
            [
              "Imports from other Chinese ports",
              "1,800,837",
              "7,964,548",
              "19,136,989"
