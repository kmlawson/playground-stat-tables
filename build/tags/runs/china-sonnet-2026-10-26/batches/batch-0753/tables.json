  {
    "key": "china-1938:p0138_1",
    "book": {
      "slug": "china-1938",
      "title": "The China Year Book 1938",
      "collection": "china"
    },
    "table": {
      "image": "p0138",
      "printed_pages": [
        "115"
      ],
      "chapter": "River Conservancy and Harbours",
      "table_no": null,
      "title": "[Works and Harbour Equipment, Lung-Hai Railway Terminal Port (Lienyünchiang)]",
      "caption_extra": "Lung-Hai Railway Terminal Port (Lienyünchiang). Works in course of construction: \"The works to be executed under these contracts consisted of :\" (contracts granted to the Netherlands Harbour Works Company of Amsterdam, May 1933 and February 1934). Equipment: \"The Lung-Hai Railway Administration in 1936 constructed the following harbour equipment and accommodation :\"",
      "parts": [
        {
          "label": "Works under the contracts",
          "columns": [
            "Portion",
            "Work"
          ],
          "rows": [
            [
              "1st portion",
              "A breakwater 1,050 metres long;"
            ],
            [
              "1st portion",
              "A pier adjacent to the breakwater, 60 metres wide, 450 metres long, with a depth alongside of 6 metres below lowest low water;"
            ],
            [
              "1st portion",
              "A harbour basin to be dredged to a depth of 5 metres below lowest low water, about 1,050 metres long, and 260 metres wide."
            ],
            [
              "2nd portion",
              "A pier parallel to and 260 metres west of the first pier and breakwater, 55 metres wide, 450 metres long, with a depth alongside of 6 metres below lowest low water;"
            ],
            [
              "2nd portion",
              "An entrance channel 4,900 metres long, 80 metres wide, with a depth of 5 metres below lowest low water, to be dredged to the east extremity of Silientao."
            ]
          ]
        },
        {
          "label": "Harbour equipment and accommodation constructed in 1936",
          "columns": [
            "Item"
          ],
          "rows": [
            [
              "Three 3-ton luffing cranes (electric) for the handling of general cargo on the 1st pier."
            ],
            [
              "A coal-loading installation with a capacity of 400 tons per hour."
            ],
            [
              "A godown of steel structure 140 metres long, and 22 metres wide."
            ],
            [
              "A power-station with two units of 500 KVA each."
            ],
            [
              "A station building covering an area of 78 metres × 15 metres, four stories high, which will accommodate the various organizations dealing with harbour affairs."
            ],
            [
              "A lighthouse at Chaneushan Island (車牛山), 20 miles north-east of the island of Silientao, the construction of which is undertaken by the Chinese Maritime Customs ; the visibility of the light will be about 20 nautical miles."
            ]
          ]
        }
      ],
      "footnotes": [
        "These works were completed by the end of April, 1936."
      ],
      "transcriber_notes": [
        "Rows: 5 (works: 3 in 1st portion, 2 in 2nd portion) + 6 (equipment) as printed.",
        "First letters of some lines are faint at the gutter edge but legible on the full page.",
        "No totals."
      ],
      "images": [
