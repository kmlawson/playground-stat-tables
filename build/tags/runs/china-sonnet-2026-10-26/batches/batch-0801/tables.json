      "table_no": null,
      "title": "[Functions and powers of the chia council]",
      "caption_extra": "First is the chia council composed of the various household heads (Article 63) and it has the following functions and powers:",
      "continued": false,
      "parts": [
        {
          "label": null,
          "columns": [
            "No.",
            "Item"
          ],
          "rows": [
            [
              "(1)",
              "To elect and recall the chia chief,"
            ],
            [
              "(2)",
              "To enforce laws and orders,"
            ],
            [
              "(3)",
              "To inspect and report census changes in the chia,"
            ],
            [
              "(4)",
              "To decide sanitation and health matters in the chia,"
            ],
            [
              "(5)",
              "To suggest new projects or reforms in the chia."
            ]
          ]
        }
      ],
      "footnotes": [],
      "transcriber_notes": [
        "Numbered list in running text, transcribed under the lists rule.",
        "'hsiang', 'chen', 'hsien', 'pao', 'chia' italic in print."
