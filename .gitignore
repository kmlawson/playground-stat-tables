# no scans, photos or PDFs in this repo
*.heic
*.HEIC
*.jpg
*.jpeg
*.JPG
*.png
*.gif
*.tif
*.tiff
*.jp2
*.webp
*.pdf
*.PDF
*.zip
.DS_Store
__pycache__/
# Full Search index: built locally with build/build_search.py and uploaded to the host; not kept in git
pagefind/
pagefind-titles/
# Local classification request databases, caches and logs are not site data.
build/tags/**/*.sqlite*
build/tags/**/*.log
build/tags/**/worker.lock
# Local table-extraction inspection pages and source images.
/inspect/
# Finder pages: work files (previews, agent scratch, reports); the specs that matter are in build/finders/<name>/specs/
build/finders/*/work/
